{
  "name": "helpdesk-desktop",
  "productName": "HelpDesk",
  "version": "1.0.0",
  "description": "Sistema HelpDesk",
  "main": "main.js",
  "author": "UAS",
  "private": true,

  "scripts": {

    "start": "electron .",

    "dist": "electron-builder"

  },

  "devDependencies": {

    "electron": "^43.0.0",

    "electron-builder": "^26.15.3"

  },

  "build": {

    "appId": "mx.uas.helpdesk",

    "productName": "HelpDesk",

    "directories": {

      "output": "release"

    },

    "files": [
      "main.js",
      "preload.js",
      "installer/**/*"
    ],

    "extraResources":[

      {
        "from":"../Servicio_Recolector",
        "to":"Servicio_Recolector"
      },

      {
        "from":"../Help_Desk_Frontend/dist",
        "to":"frontend"
      }

    ],

    "asar": true,

    "win": {

      "target": "nsis",

      "icon": "build/icon.ico"

    },

    "nsis": {

      "oneClick": false,

      "allowElevation": true,

      "allowToChangeInstallationDirectory": true,

      "createDesktopShortcut": true,

      "createStartMenuShortcut": true,

      "include": "installer/installer.nsh"

    }

  }

}